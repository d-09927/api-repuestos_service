# URL base de la API de repuestos (con el prefijo /api)
REPUESTOS_API_URL=http://localhost:3000/api

# Transporte del MCP: stdio (lo lanza el agente como proceso hijo) o http (servicio con URL propia)
MCP_TRANSPORT=stdio
# Solo para http
MCP_PORT=3100
# Opcional (http): si se define, el cliente debe enviar "Authorization: Bearer <token>"
MCP_TOKEN=

# Herramientas que MODIFICAN datos (reservar, vender, comprar). Apagadas por defecto.
MCP_PERMITIR_ESCRITURA=false
