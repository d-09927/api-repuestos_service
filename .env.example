PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=repuestos
DB_PASSWORD=repuestos_dev
DB_NAME=repuestos

# true crea/actualiza las tablas solo (útil en desarrollo).
# En producción usar migraciones y poner false.
DB_SYNCHRONIZE=true

# MCP para agentes (POST /mcp). Sin MCP_TOKEN, /mcp responde 503.
MCP_TOKEN=cambia-este-token
# true habilita reservar, liberar, vender y comprar (siempre con confirmación).
# Token de AutoMax (16 caracteres o más): solo ve consultar_compras_vin.
MCP_TOKEN_AUTOMAX=
MCP_PERMITIR_ESCRITURA=false
# Cómo nos identificamos ante facturación en consultar_precio_repuesto, y el IVA que ya traen los precios del catálogo.
TIENDA_NOMBRE=Tienda de repuestos
IVA_PORCENTAJE=19
# Comprador de los repuestos de las órdenes de taller (las ventas por cobrar quedan a su nombre).
FACTURACION_NIT=900000000-0
FACTURACION_NOMBRE=Facturación (Ventas y contabilidad)

# Modelo del agente (cualquier API compatible con OpenAI). Con Ollama local, crear antes el modelo:
#   ollama create qwen3.5-agente -f ollama/Modelfile
IA_URL=http://localhost:11434/v1
IA_KEY=ollama
IA_MODELO=qwen3.5-agente

# El agente usa el MCP de esta misma API (como lo haría cualquier otro cliente). Mismo valor que MCP_TOKEN.
AGENTE_MCP_URL=http://localhost:3100/mcp
AGENTE_MCP_TOKEN=cambia-este-token